# Server Configuration
PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>

# JWT Secret Key for token signing and verification (Required, must be kept private)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Secret Key required to register as Administrator via /api/auth/signup
ADMIN_SIGNUP_KEY=your_admin_signup_key

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
